# AI coach (optional). Copy to .env.local and fill in; .env.local is gitignored.
# Without a key the app still works: the deterministic generator designs plans.
#
# The key never reaches the browser. The Vite dev/preview server proxies
# /api/minimax and injects the Authorization header on its side.
#
# Use a non-reasoning model here: MiniMax-M2/M3 wrap answers in <think> blocks
# and routinely run past the request timeout for structured output.
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.chat/v1
MINIMAX_MODEL=MiniMax-Text-01

# Recipe suggestions (optional). Free tier at spoonacular.com/food-api gives
# 150 points/day, which the daily cache spends a fraction of. Without a key
# the app falls back to the bundled sample dishes; the dish of the day comes
# from TheMealDB and needs no key at all.
SPOONACULAR_API_KEY=
