# AI coach (optional). Copy to .env.local and fill in; .env.local is gitignored.
# Without a key the app still works: the deterministic generator designs plans.
#
# The key never reaches the browser. The Vite dev/preview server proxies
# /api/minimax and injects the Authorization header on its side.
#
# Use a non-reasoning model here: MiniMax-M2/M3 wrap answers in <think> blocks
# and routinely run past the request timeout for structured output.
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.chat/v1
MINIMAX_MODEL=MiniMax-Text-01

# Recipes need no key here. The catalogue lives on the sync server, which
# serves it through /api/enforma/recipes and tops it up from FatSecret when
# FATSECRET_CLIENT_ID / FATSECRET_CLIENT_SECRET are set in its own environment
# (deploy/pocketbase/docker-compose.yml). Without them the app falls back to its
# bundled sample dishes.

# ── Default accounts on the sync server ──────────────────────────────────────
# The pair every app in this fleet seeds so there is always something to sign in
# as. The canonical copy lives in ai-os/dev-env/env-config/.env; these are here
# so `pnpm seed:accounts` finds them without reaching outside the repository.
#
#   pnpm seed:accounts --server http://127.0.0.1:8090
#
# Two things about enForma specifically, both worth knowing before you rely on
# this. The password sent to the server is a PBKDF2 derivation of the one below,
# never the password itself — the seed imports the app's own `authPassOf`, so an
# account it creates is one the app can actually sign into. And an account is
# only half an identity here: the local profile is encrypted in the browser from
# a passphrase, so no script can make one. Create the profile in the app, then
# Sign in to sync; the admin role arrives on the next sync.
DEFAULT_ADMIN_EMAIL=edd_admin@local.com
DEFAULT_ADMIN_PASSWORD=
DEFAULT_USER_EMAIL=edd_user@local.com
DEFAULT_USER_PASSWORD=

# The superuser the sync server booted with (docker-compose PB_SUPERUSER_*).
# Seeding needs it: creating a user and granting platform admin are both
# privileged, and no member account can do either.
PB_SUPERUSER_EMAIL=
PB_SUPERUSER_PASSWORD=

# --- Stripe, on the sync server only -----------------------------------------
#
# None of these reach the browser. The client learns whether this server can
# take a card from `/api/enforma/capabilities`, which reports a boolean and a
# portal URL and nothing else, and the checkout itself happens on Stripe's
# domain. There is no card field anywhere in this codebase.
#
# The mode is derived from the key, not configured: `sk_test_` accepts test
# events and `sk_live_` accepts live ones, and a key whose prefix cannot be read
# accepts neither. That is one variable instead of two that can disagree.
#
# VAT: `automatic_tax` is on, so the rate charged is right from the first sale.
# Registering for OSS in Denmark, remitting and filing the quarterly return stay
# with the seller from the first consumer sale into the EU, and no configuration
# moves that. See HunterReady's ADR-034, where the alternative was priced.
STRIPE_SECRET_KEY=
STRIPE_PRICE_MONTHLY=
# From the webhook endpoint in the Stripe dashboard, not the API keys page.
STRIPE_WEBHOOK_SECRET=
# Set only while rotating the endpoint secret: both verify until the old one is
# retired, so events are not dropped during the roll.
STRIPE_WEBHOOK_SECRET_PREVIOUS=
# Stripe's own hosted billing portal login link. Cancelling happens there
# because it is legally theirs to get right.
STRIPE_PORTAL_URL=
# Where Stripe returns somebody after checkout. Falls back to the request's
# Origin, but the configured value is the one to trust.
APP_URL=
